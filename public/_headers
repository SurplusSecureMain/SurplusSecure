/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://ss-form.kelli-6a0.workers.dev https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# NOTE ON CSP: 'unsafe-inline' is required for both script-src and style-src
# because the entire site is a single file with inline <style> and <script>.
# connect-src allowlists the ss-form Worker the contact form POSTs to, plus
# challenges.cloudflare.com for Turnstile (CAPTCHA on the contact form).
# frame-src allows the Turnstile widget's iframe. If an admin API is ever
# wired up via the admin-api meta tag, its origin has to be added to
# connect-src or the content-injection fetch will be blocked.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000

/hero-video.mp4
  Cache-Control: public, max-age=31536000

/hero-poster.webp
  Cache-Control: public, max-age=31536000

/og-image.png
  Cache-Control: public, max-age=604800
